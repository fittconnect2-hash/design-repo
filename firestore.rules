/**
 * # Firestore Security Rules for DesignDock
 *
 * ## Core Philosophy
 * This ruleset enforces a strict user-ownership security model for writes,
 * while allowing public read access for sharing purposes on designs. It also
 * defines an 'Admin' role with elevated privileges, including a hardcoded
 * Super Admin.
 *
 * ## Data Structure
 * The data is organized hierarchically. All user-specific data is nested under
 * `/users/{userId}`, where `{userId}` is the user's unique Firebase Authentication UID.
 * This structure makes ownership explicit.
 *
 * ## Key Security Decisions
 * - **Super Admin:** The user 'fittconnect2@gmail.com' is a super admin with universal access.
 * - **Admin Role:** Users with `role == 'Admin'` in their profile can manage users, projects, and designs.
 * - **Public Read for Designs:** The `designs` subcollection is publicly readable (`get`, `list`)
 *   to support the public sharing feature. A design is only gettable if `isPublic` is true.
 * - **Private Projects:** The `projects` subcollection is private. Only the owner or an admin can read or write.
 * - **Strict Write Ownership for regular users:** All write operations (`create`, `update`, `delete`) are granted
 *   only if the requesting user's UID matches the `{userId}` in the document path.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    function hasValidUserCreateData(userId) {
      return request.resource.data.id == userId;
    }

    function hasImmutableUserId() {
      return request.resource.data.id == resource.data.id;
    }

    function hasValidOwnerId(userId) {
      return request.resource.data.userId == userId;
    }

    function hasImmutableOwnerId() {
      return request.resource.data.userId == resource.data.userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'fittconnect2@gmail.com';
    }

    function isAdmin() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      // An admin is someone with the 'Admin' role in their user document OR the super admin.
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(userDocPath) &&
        get(userDocPath).data.role == 'Admin'
      );
    }

    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && hasValidUserCreateData(userId);
      allow update: if (isExistingOwner(userId) && hasImmutableUserId()) || isAdmin();
      // Only admins can delete user profiles from Firestore. This does not delete the Auth user.
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to high-level projects. Read and write are private to owners, but open to admins.
     * @path /users/{userId}/projects/{projectId}
     */
    match /users/{userId}/projects/{projectId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && hasValidOwnerId(userId)) || isAdmin();
      allow update: if (isExistingOwner(userId) && hasImmutableOwnerId()) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Controls access to designs. Read is public, writes are private to owners, but open to admins.
     * @path /users/{userId}/designs/{designId}
     */
    match /users/{userId}/designs/{designId} {
      // Anyone can read a design if it's public. Owners and Admins can read private designs.
      allow get: if resource.data.isPublic == true || isOwner(userId) || isAdmin();
      // Public listing is allowed. The client query MUST filter for isPublic == true.
      allow list: if true;
      
      // Writes are restricted to owners or admins.
      allow create: if (isOwner(userId) && hasValidOwnerId(userId)) || isAdmin();
      allow update: if (isExistingOwner(userId) && hasImmutableOwnerId()) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    match /invites/{inviteId} {
      // Admins can create and list invites.
      allow create, list: if isAdmin();
      // Anyone can read an invite if they have the ID (for the signup page).
      allow get: if true;
      // No one can update an invite.
      allow update: if false;
      // An admin can delete an invite, or a signed-in user can delete the invite they just used.
      allow delete: if isAdmin() || isSignedIn();
    }
  }
}
