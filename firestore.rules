/**
 * # Firestore Security Rules for DesignDock
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && (
        request.auth.token.email == 'fittconnect2@gmail.com' ||
        (exists(userDocPath) && get(userDocPath).data.role == 'Admin')
      );
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /designs/{designId} {
      allow get: if isSignedIn() || resource.data.isPublic == true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /invites/{inviteId} {
      allow read: if true;
      allow create, list, delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read, write: if isSignedIn();
    }

    match /auditLogs/{auditLogId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    match /notes/{noteId} {
      // Allow user to list only their own notes. 
      // The query MUST include a filter where('userId', '==', auth.uid)
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Allow individual document access
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Allow user to create notes for themselves
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Allow user to update/delete their own notes
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
